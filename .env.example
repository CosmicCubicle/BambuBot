DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id-here
GUILD_ID=your-test-guild-id-here

# Bambu Lab local LAN MQTT notifications and controls.
# Add one object per printer. Use each printer's LAN IP, LAN access code, and serial number.
BAMBU_PRINTERS=[{"name":"X1 Carbon","host":"192.168.1.50","accessCode":"your-lan-access-code","serialNumber":"your-serial-number"}]

# Optional: also stream command logs to an Azure Event Hub (in addition to logs/commands.log).
# Leave unset to only log to file.
EVENT_HUB_CONNECTION_STRING=
EVENT_HUB_NAME=

# Optional: post command logs to Discord channels.
# LOG_CHANNEL_ID is used for both success and failure if the specific ones below aren't set.
# Set LOG_CHANNEL_SUCCESS_ID / LOG_CHANNEL_ERROR_ID to split them into different channels.
LOG_CHANNEL_ID=
LOG_CHANNEL_SUCCESS_ID=
LOG_CHANNEL_ERROR_ID=
