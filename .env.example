DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id-here
GUILD_ID=your-test-guild-id-here

# Bambu Lab cloud-relayed MQTT notifications and controls.
# Use this mode to connect through Bambu's cloud infrastructure (faster, no local network required, no command verification issues).
# Get deviceId from Bambu Cloud or your printer settings; cloudAccessToken is generated via Bambu cloud auth.
# See README for setup instructions.
BAMBU_PRINTERS=[{"name":"X1 Carbon","deviceId":"your-cloud-device-id","cloudAccessToken":"your-cloud-access-token","serialNumber":"your-serial-number"}]

# Optional: post command logs to Discord channels.
# LOG_CHANNEL_ID is used for both success and failure if the specific ones below aren't set.
# Set LOG_CHANNEL_SUCCESS_ID / LOG_CHANNEL_ERROR_ID to split them into different channels.
LOG_CHANNEL_ID=
LOG_CHANNEL_SUCCESS_ID=
LOG_CHANNEL_ERROR_ID=

# Note: LAN-based camera relay is not available in cloud mode (no direct printer access).
# Use Bambu's cloud image URLs or web interface for remote camera access.
