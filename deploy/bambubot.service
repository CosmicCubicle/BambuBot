[Unit]
Description=BambuBot Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cosmic
WorkingDirectory=/opt/BambuBot
ExecStart=/home/cosmic/.nvm/versions/node/v20.20.2/bin/node /opt/BambuBot/index.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
