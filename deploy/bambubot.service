[Unit]
Description=BambuBot Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cosmic
WorkingDirectory=/opt/BambuBot
ExecStart=/bin/bash -lc 'source "$HOME/.nvm/nvm.sh" && exec node /opt/BambuBot/index.js'
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
