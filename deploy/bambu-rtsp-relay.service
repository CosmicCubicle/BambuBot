[Unit]
Description=Relay Bambu Lab printer camera to RTSP
After=bambubot.service mediamtx.service
Requires=bambubot.service mediamtx.service

[Service]
Type=simple
User=cosmic
EnvironmentFile=/opt/BambuBot/hom.env
ExecStart=/opt/BambuBot/deploy/start-rtsp-relay.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
